{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "find-buzz",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "find-buzz",
      "database_id": "local-placeholder",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // UTC。取得=JST 0/6/12/18時、ダイジェスト=JST 7:30
    "crons": ["0 3,9,15,21 * * *", "30 22 * * *"]
  },
  "vars": {
    "DIGEST_SIZE": "10",
    // デプロイ後のURL。Slack通知の「一覧を開く」リンクに使う
    "APP_URL": ""
  },
  "observability": { "enabled": true }
}
