{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "find-buzz",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "find-buzz",
      "database_id": "1f225b1a-d9c4-45fa-aa17-d3801d4ef008",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // UTC。ダイジェスト=JST 7:30(取得は .github/workflows/fetch.yml)
    "crons": ["30 22 * * *"]
  },
  "vars": {
    "DIGEST_PER_SOURCE": "3",
    // デプロイ後のURL。Slack通知の「一覧を開く」リンクに使う
    "APP_URL": "https://find-buzz.youth1975.workers.dev"
  },
  "observability": { "enabled": true }
}
